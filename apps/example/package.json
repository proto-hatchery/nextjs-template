    "@workspace/forms": "workspace:*",
    "@workspace/logging": "workspace:*",
    "@workspace/safe-action": "workspace:*",
    "@workspace/seo": "workspace:*",
    "@workspace/supabase-auth": "workspace:*",
    "@workspace/supabase-infra": "workspace:*",
    "@workspace/ui": "workspace:*",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "next-intl": "^4.13.0",
    "next-safe-action": "^8.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.79.0",
    "sharp": "^0.35.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/env": "16.2.9",
