    "./components/specialized/v2/*": "./src/forms/components/specialized/v2/*.component.tsx",
    "./fields/*": "./src/forms/fields/*.ts",
    "./fields/utils/*": "./src/forms/fields/utils/*.ts",
    "./forms/*": "./src/forms/*",
    "./hooks/*": "./src/forms/hooks/*.hook.ts",
    "./lib/*": "./src/forms/lib/*.ts",
    "./helpers/*": "./src/forms/helpers/*.ts",
    "./types": "./src/forms/types/index.ts",
    "./types/*": "./src/forms/types/*.ts",
    "./utils/*": "./src/forms/utils/*.ts",
    "./v2/*": "./src/forms/v2/*.ts"
  },
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt --write",
    "test": "mkdir -p coverage/.tmp && vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "check:exports": "publint"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@internationalized/date": "^3.10.0",
    "@next-safe-action/adapter-react-hook-form": "2.0.5",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-popover": "^1.1.15",
    "@workspace/ui": "workspace:*",
    "axios": "^1.13.6",
    "cmdk": "^1.1.1",
    "countries-list": "^3.2.2",
    "date-fns": "^4.1.0",
    "input-otp": "^1.4.2",
    "libphonenumber-js": "^1.12.31",
    "lucide-react": "^1.7.0",
    "next": "16.2.3",
    "next-safe-action": "^8.3.0",
    "react": "^19.2.4",
    "react-aria-components": "^1.13.0",
    "react-circle-flags": "^0.0.25",
