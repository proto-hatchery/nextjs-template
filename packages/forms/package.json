    "./v2/kernel/*": "./src/forms/v2/kernel/*.ts",
    "./v2/schema": "./src/forms/v2/schema/index.ts",
    "./v2/schema/*": "./src/forms/v2/schema/*.ts",
    "./v2/rhf": "./src/forms/v2/rhf/index.ts",
