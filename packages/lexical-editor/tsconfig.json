{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "paths": {
      "@workspace/lexical-editor/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "vitest.config.ts"
  ],
