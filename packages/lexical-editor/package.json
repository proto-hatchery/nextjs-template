{
  "name": "@workspace/lexical-editor",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./components/full-page-editor": "./src/components/full-page-editor.tsx",
    "./components/inline-editor": "./src/components/inline-editor.tsx",
    "./autosave/use-robust-note-autosave": "./src/autosave/use-robust-note-autosave.ts",
    "./autosave/note-drafts-db": "./src/autosave/note-drafts-db.ts",
    "./autosave/autosave-utils": "./src/autosave/autosave-utils.ts",
    "./autosave/note-save-status-indicator": "./src/autosave/note-save-status-indicator.tsx",
    "./autosave/local-draft-recovery-banner": "./src/autosave/local-draft-recovery-banner.tsx",
    "./nodes": "./src/nodes/index.ts",
    "./themes": "./src/themes/index.ts",
    "./types": "./src/types.ts",
    "./utils/encoding": "./src/utils/encoding.ts",
    "./styles/sources.css": {
      "import": "./src/styles/sources.css",
      "style": "./src/styles/sources.css"
    }
  },
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt --write",
    "typecheck": "tsc --noEmit",
    "check:exports": "publint",
    "generate:pt-br-accent-index": "node ./scripts/generate-pt-br-accent-index.mjs",
    "test": "mkdir -p coverage/.tmp && vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16",
    "@lexical/code": "^0.38.2",
    "@lexical/extension": "^0.38.2",
    "@lexical/link": "^0.38.2",
    "@lexical/list": "^0.38.2",
    "@lexical/react": "^0.38.2",
    "@lexical/rich-text": "^0.38.2",
    "@lexical/selection": "^0.38.2",
    "@lexical/table": "^0.38.2",
    "@lexical/utils": "^0.38.2",
    "@workspace/brand": "workspace:*",
    "@workspace/ui": "workspace:*",
    "dexie": "^4.3.0",
    "lexical": "^0.38.2",
    "lucide-react": "^1.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.3",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "dictionary-pt": "4.0.0",
    "jsdom": "^29.0.1",
    "publint": "^0.3.18",
    "typescript": "5.9.3",
    "vitest": "^4.1.3"
  },
  "type": "module"
}
